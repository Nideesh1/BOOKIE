# Root .env: read by docker compose for the Langfuse / ClickHouse infra services.
# Copy to .env (or run scripts/gen-env.sh, which fills the random ones for you).
# Nothing here is user-specific; the 3 keys YOU must fill live in worker/.env.

# ClickHouse password used by Langfuse.            generate with: openssl rand -hex 32
CLICKHOUSE_PASSWORD=change-me
# Password for Langfuse's private Redis.           generate with: openssl rand -hex 32
LANGFUSE_REDIS_AUTH=change-me
# NextAuth session secret for the Langfuse web UI. generate with: openssl rand -hex 32
NEXTAUTH_SECRET=change-me
# Langfuse password hashing salt.                  generate with: openssl rand -hex 32
SALT=change-me
# Langfuse at-rest encryption key (64 hex chars).  generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me
# Langfuse project public key; any "pk-lf-..." string, seeded on first boot.
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
# Langfuse project secret key; any "sk-lf-..." string, seeded on first boot.
LANGFUSE_SECRET_KEY=sk-lf-change-me
# Login password for you@example.com at http://localhost:3000 (>= 8 chars).
LANGFUSE_PASSWORD=change-me
