# worker/.env: read by the api / worker / brain processes (host or container).
# Copy to worker/.env (or run scripts/gen-env.sh). Three keys are REQUIRED from you:
#   MONGODB_URI, MODEL_API_KEY, VOYAGE_API_KEY  -- everything else has a working default.

# --- LLM (OpenAI-compatible; OpenRouter by default) ---
# Base URL of the chat-completions endpoint.
MODEL_BASE_URL=https://openrouter.ai/api/v1
# Model id the brain forecasts with.
MODEL_NAME=openai/gpt-5.6-luna
# REQUIRED: your OpenRouter API key (https://openrouter.ai/keys).
MODEL_API_KEY=sk-or-v1-REPLACE_ME

# --- Store ---
# REQUIRED: MongoDB connection string (Atlas or local); every read/write goes here.
MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/?retryWrites=true&w=majority
# Database name inside that cluster.
MONGODB_DB=bookie

# --- Hatchet (durable workflows) ---
# Leave EMPTY under docker compose: the hatchet_token service mints one into a shared
# volume and worker/entrypoint.sh exports it. Fill only when running on the host.
HATCHET_CLIENT_TOKEN=
# Engine gRPC address (host default; compose overrides to hatchet-engine:7070).
HATCHET_CLIENT_HOST_PORT=localhost:7077
# Plain-text gRPC to the local engine.
HATCHET_CLIENT_TLS_STRATEGY=none
# Hatchet REST/dashboard URL (host default; compose overrides to http://hatchet-dashboard:80).
HATCHET_CLIENT_SERVER_URL=http://localhost:8080

# --- Tracing (OTLP -> Langfuse) ---
# OTLP endpoint (host default; compose overrides to http://langfuse_web:3000/api/public/otel).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
# "Authorization=Basic <base64 of LANGFUSE_PUBLIC_KEY:LANGFUSE_SECRET_KEY>" from the root .env.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic REPLACE_ME

# --- Upstream data / bus ---
# NWS requires an identifying User-Agent with a contact address.
NWS_USER_AGENT=bookie (you@example.com)
# Redis Streams bus (host default; compose overrides to redis://bus:6379/0).
REDIS_URL=redis://localhost:6380/0

# Voyage AI (vector search over past reasoning); leave empty to disable
# REQUIRED for memory search: https://dash.voyageai.com
VOYAGE_API_KEY=pa-REPLACE_ME

# --- Phase 3: Kalshi exchange (orders) ---
# Master switch. Anything but "true" keeps every order path in dry-run: payloads are recorded as "would_place", nothing is sent.
ORDERS_ENABLED=false
# Kalshi API key id (demo and prod keys are separate; https://docs.kalshi.com/getting_started/api_keys).
KALSHI_API_KEY_ID=
# Path to the RSA private key PEM that pairs with the key id above. Never commit it.
KALSHI_PRIVATE_KEY_PATH=
# demo (https://demo-api.kalshi.co) or prod (https://api.elections.kalshi.com).
KALSHI_ENV=demo
# --- Phase 3b: hard risk rules (engine/risk.py + engine/clamps.py; defaults sized for a ~$20 account) ---
# Close a position once its unrealized loss reaches this % of entry cost (forced, no human gate).
MAX_LOSS_PCT_PER_POSITION=20
# No new opens once today's realized + unrealized P&L is at or below -this (closes still allowed).
DAILY_LOSS_CAP_USD=10
# Dollars at risk per day / per bucket (clamps 2 and 3).
DAILY_CAP_USD=50
BUCKET_CAP_USD=5
# Hard per-order size cap enforced in engine/clamps.py on top of the dollar caps.
MAX_CONTRACTS_PER_ORDER=3
# No new orders in the last N minutes before settlement lock; losing positions get a forced close in that window.
LOCK_MINUTES=30
# Kill switch: if this file exists (or BOOKIE_KILL=1) every order, closes included, is rejected.
KILL_SWITCH=/tmp/bookie.kill
MANAGED_SERIES=KXHIGHNY   # bookie only manages positions in this series
